{
  "name": "kelo-mcp",
  "version": "1.0.0",
  "description": "A small, dependency-free Model Context Protocol server core, extracted from Kelo. Hand-rolled JSON-RPC, read-and-draft-only tool surface.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/server.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-rpc",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
